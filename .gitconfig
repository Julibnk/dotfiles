# This is Git's per-user configuration file.
[user]
  name = julibnk
  email = fernandezfernandezjulian@gmail.com

[init]
  defaultBranch = main

[core]
  pager = "delta"
  editor = nvim

[merge]
  conflictstyle = zdiff3
  tool = diffview

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "diffview"]
  # $MERGED es el fichero real del working tree, así que Diffview edita el
  # mismo fichero que git va a stagear al salir.
  cmd = nvim -n -c "DiffviewOpen" "$MERGED"
  trustExitCode = true


[interactive]
  diffFilter = delta --color-only 

[diff]
  colorMoved = default
  algorithm = histogram

[branch]
    sort = -committerdate

[pull]
	rebase = true

; [column]
;     ui = auto

# DELTA
[delta]
  pager = less
  navigate = true
  hyperlinks = true
  line-numbers = true
  side-by-side = false
  dark = true
  wrap-max-lines = 0
  file-decoration-style = ul
  hunk-header-decoration-style = none
  hunk-header-style = file line-number syntax
  merge-conflict-begin-symbol = ⌃
  merge-conflict-end-symbol = ⌄
  merge-conflict-ours-diff-header-style = "#F0C269 bold"
  merge-conflict-ours-diff-header-decoration-style = "#F0C269 box"
  merge-conflict-theirs-diff-header-style = "#66BED9 bold"
  merge-conflict-theirs-diff-header-decoration-style = "#66BED9 box"
  features = catppuccin-mocha

[delta "interactive"]
  keep-plus-minus-markers = true

[alias]
  conflicts = diff --name-only --diff-filter=U
  remerge = show --remerge-diff
  ds = diff --staged
  # Abre Diffview una sola vez con TODOS los conflictos (mejor que `git mergetool`,
  # que relanza el editor fichero a fichero).
  mt = !nvim -c DiffviewOpen
  # `git difftool` no puede recibir revisiones: itera fichero a fichero pasando
  # solo $LOCAL/$REMOTE. Con un alias sí reenviamos los argumentos tal cual.
  #   git dt              -> working tree
  #   git dt HEAD~3       -> contra HEAD~3
  #   git dt main...HEAD  -> la rama contra su merge base
  #   git dt HEAD -- src/ -> limitado a un path
  dt = "!f() { nvim -c \"DiffviewOpen $*\"; }; f"
  dpr = "!f() { nvim -c \"DiffviewFileHistory $* --right-only --no-merges\"; }; f"

[delta "catppuccin-mocha"]
  blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
  commit-decoration-style = "#6c7086" bold box ul
  dark = true
  file-decoration-style = "#6c7086"
  file-style = "#cdd6f4"
  hunk-header-decoration-style = "#6c7086" box ul
  hunk-header-file-style = bold
  hunk-header-line-number-style = bold "#a6adc8"
  hunk-header-style = file line-number syntax
  line-numbers-left-style = "#6c7086"
  line-numbers-minus-style = bold "#f38ba8"
  line-numbers-plus-style = bold "#a6e3a1"
  line-numbers-right-style = "#6c7086"
  line-numbers-zero-style = "#6c7086"
  # 50% red 50% base
  minus-emph-style = bold syntax "#89556b"
  # 30% red 70% base
  minus-style = syntax "#5e3f53"
  # 50% green 50% base
  plus-emph-style = bold syntax "#628168"
  # 30% green 70% base
  plus-style = syntax "#475951"
  map-styles = \
  	bold purple => syntax "#5b4e74", \
  	bold blue => syntax "#445375", \
  	bold cyan => syntax "#446170", \
  	bold yellow => syntax "#6b635b"
  # Should match the name of the bat theme
  syntax-theme = Catppuccin Mocha

[rebase]
	autoStash = true
	updateRefs = true
